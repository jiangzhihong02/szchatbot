# 複製為 .env.local 並填入真值。此檔僅為範本，不含任何密鑰。

# ── Anthropic（自由問答，票 04）────────────────────────────
# 必填，否則 /api/chat 走降級文案。指向真正的 Anthropic API。
ANTHROPIC_API_KEY=
# 可選。模型，預設 claude-opus-4-8（最新為 claude-opus-5，同價 $5/$25）。
# 刻意用 APP_ 前綴，避免與 shell 裡 Claude Code 的 ANTHROPIC_MODEL 衝突。
APP_ANTHROPIC_MODEL=claude-opus-4-8
# 可選。端點，預設 https://api.anthropic.com。
# 若你要走自訂代理，才需設定；**切勿**讓它繼承 shell 的 ANTHROPIC_BASE_URL。
APP_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── 高德地圖（路線地圖，票 10）────────────────────────────
# 高德開放平台 → Web 端（JS API）應用。
# AMAP_KEY=
# AMAP_SECURITY_CODE=

# ── 和風天氣（3 日預報，票 06）────────────────────────────
# 未配置時自動回退到 mock 資料，demo 仍可跑。
# QWEATHER_KEY=
# QWEATHER_HOST=
