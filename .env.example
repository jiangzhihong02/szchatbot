# 複製為 .env.local 並填入真值。此檔僅為範本，不含任何密鑰。

# ── LLM（自由問答，票 04）────────────────────────────────
# 用 Anthropic 相容端點。若用官方 Anthropic，填 sk-ant-… 並把 BASE_URL 設為
# https://api.anthropic.com；若用第三方相容端點（如本專案開發時所用），填該端點的 key 與網址。
ANTHROPIC_API_KEY=
# 預設 claude-opus-4-8（最新為 claude-opus-5，同價 $5/$25）。
APP_ANTHROPIC_MODEL=claude-opus-4-8
# 端點。留空則用官方 https://api.anthropic.com。
APP_ANTHROPIC_BASE_URL=

# ── 高德開放平台（天氣預報 + 路線地圖）────────────────────
# 「Web 服務」類型 key 供伺服器端呼叫（天氣、路徑規劃）。
AMAP_KEY=
# 數字簽名私鑰（選配）。在高德控制台為此 key 啟用數字簽名後取得。
# 填了就每個請求都附 sig——洩漏的 key 在沒有私鑰時無法使用，比輪換 key 徹底。
# 兩側必須一致：控制台開了而這裡沒填 → 全部 10007。
AMAP_SECRET=
# 前端 JS API 用的 key 與安全密鑰（票 10 路線地圖）。
# AMAP_JS_KEY=
# AMAP_SECURITY_CODE=
